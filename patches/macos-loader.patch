+package com.elfmcys.ysm.util;
+
+import java.util.Locale;
+
+/** Bundled macOS library selection, shared by the loader and the headless CI smoke check. */
+public final class BundledMacLibrary {
+    private BundledMacLibrary() {}
+
+    public static String fileName(String osName, String architecture) {
+        String os = osName.toLowerCase(Locale.ROOT);
+        String arch = architecture.toLowerCase(Locale.ROOT);
+        if (!(os.contains("mac") || os.contains("darwin"))) return null;
+        if (arch.equals("aarch64") || arch.equals("arm64")) return "libysm.dylib";
+        if (arch.equals("amd64") || arch.equals("x86_64")) return "libysm-x86_64.dylib";
+        return null;
+    }
+}
